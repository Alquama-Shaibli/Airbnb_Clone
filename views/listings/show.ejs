<% layout("layouts/boilerplate") %>

  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3> <%= listing.title %> </h3>

      <div class="card col-6 offset-3 show card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image" />
        <div class="card-body">
          <p class="card-text"><b>
              
            </b></p>
          <p class="card-text">
            <%= listing.description %>
          </p>
          <p class="card-text">&#8377; <%= listing.price?.toLocaleString("en-IN") ?? "N/A" %>
          </p>
          <p class="card-text">
            <%= listing.location %>
          </p>
          <p class="card-text">
            <%= listing.country %>
          </p>
        </div>
      </div>

      <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark show-btn">Edit</a>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
          <button class="btn btn-danger show-btn">Delete</button>
        </form>
      </div>
      
      <div class ="col-8 offset-3">
        <hr/>

       <h4>Leave a Review</h4>

       <form  class="mb-3 mt-3" action="/listings/<%= listing._id %>/reviews" method="POST">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating:</label>
          <input type="range" id="review[rating]" name="rating" min="1" max="5" required class="form-range">
        </div>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comment:</label>
          <textarea id="review[comment]" name="comment"  rows="4" class="form-control" required></textarea>
        </div>
        <button type="submit" class="btn btn-outline-dark">Submit Review</button>
       </form>

      </div>


    </div>
  </div>